# Example environment for dmp.job.server. Copy to .env (never commit real values).
# Nested settings use the ASP.NET Core "Section__Key" convention.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL: DMP database (also hosts the Hangfire schema)
ConnectionStrings__DmpConnection=Host=postgres-dmp;Port=5432;Database=dmarketplace;Username=admin;Password=change-me;SSLMode=disable;Pooling=true

# Redis Stack (RedisJSON is required)
REDIS_HOST=dmp-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# SMTP used to deliver queued e-mails
SmtpSettings__Host=mailhog-dmp
SmtpSettings__Port=1025
SmtpSettings__UserName=
SmtpSettings__Password=
SmtpSettings__Ssl=false

# Telegram system notifications
TelegramSettings__Enabled=false
TelegramSettings__BotToken=
TelegramSettings__SysChatId=

# Hangfire dashboard Basic auth (dashboard is unauthenticated when either value is empty)
HangfireDashboard__Username=admin
HangfireDashboard__Password=change-me
